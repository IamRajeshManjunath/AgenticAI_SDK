{
  "workflow_id": "enterprise-hierarchy-v3",
  "name": "Hierarchical Enterprise Workflow (v0.3)",
  "description": "A complex manager-worker workflow. A 'Coordinator' agent delegates specific sub-tasks to 'Researcher' and 'Writer' specialists using hierarchical tool calls. Includes safety guardrails, fallbacks, consensus, memory management, context compression, and schema enforcement.",
  "tools": [
    {
      "tool_id": "google_search",
      "name": "Google Search",
      "description": "Search the web for real-time information",
      "type": "rest_api",
      "config": {
        "endpoint": "https://api.search.com/v1",
        "method": "GET",
        "api_key_env_var": "SEARCH_API_KEY"
      }
    },
    {
      "tool_id": "data_cleaner",
      "name": "Data Cleaner",
      "description": "Custom Python function to clean research text",
      "type": "custom_python",
      "config": {
        "code": "def data_cleaner(text: str) -> str:\n    return text.strip().replace('\\n', ' ')",
        "arguments": {}
      }
    },
    {
      "tool_id": "mcp_weather",
      "name": "MCP Weather",
      "description": "Model Context Protocol weather tool",
      "type": "mcp",
      "config": {
        "connection_string": "http://mcp-server:8080/weather",
        "arguments": {
          "mcp_tool_name": "get_current_weather"
        }
      }
    }
  ],
  "rag_sources": [
    {
      "rag_id": "internal_docs",
      "vector_db": "qdrant",
      "connection_uri": "http://localhost:6333",
      "collection_name": "enterprise_kb",
      "embedding_provider": "openai"
    }
  ],
  "agents": [
    {
      "agent_id": "coordinator",
      "role": "Strategic Project Coordinator responsible for high-level planning and delegation",
      "prompt_template": {
        "template_id": "coordinator_prompt",
        "template_string": "You are the central coordinator for this request: {topic}. \n\nYour task is to:\n1. Delegate deep research to the 'researcher' specialist.\n2. Once research is received, delegate report writing to the 'writer' specialist.\n3. Review the final report and ensure it meets executive standards.",
        "input_variables": ["topic"]
      },
      "llm": {
        "provider": "openai",
        "model_name": "gpt-4o",
        "temperature": 0.1,
        "api_key_env_var": "OPENAI_API_KEY"
      },
      "memory": {
        "execution_memory_type": "short_term",
        "window_size": 20,
        "caching_strategy": "in_memory"
      },
      "sub_agents": ["researcher", "writer"],
      "topology": {
        "orchestration_mode": "model_driven"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" }
        },
        "required": ["topic"]
      }
    },
    {
      "agent_id": "researcher",
      "role": "Expert Technical Researcher",
      "prompt_template": {
        "template_id": "researcher_v2",
        "template_string": "Search and synthesize the latest information on: {topic}. Use search and internal docs.",
        "input_variables": ["topic"]
      },
      "llm": {
        "provider": "anthropic",
        "model_name": "claude-3-5-sonnet-latest",
        "api_key_env_var": "ANTHROPIC_API_KEY"
      },
      "tools": ["google_search", "data_cleaner", "mcp_weather"],
      "rag_sources": ["internal_docs"],
      "fallback_llms": [
        {
          "provider": "openai",
          "model_name": "gpt-4o-mini",
          "api_key_env_var": "OPENAI_API_KEY"
        }
      ],
      "middleware_config": {
        "budget": {
          "max_tokens_per_call": 2048,
          "max_cost_per_workflow": 0.50
        },
        "pii": {
          "enabled": true,
          "masking_level": "hash"
        },
        "injection_firewall": {
          "enabled": true
        },
        "rate_limiter": {
          "max_requests_per_minute": 10
        },
        "context_compression": {
          "enabled": true,
          "max_context_tokens": 8192,
          "strategy": "truncate"
        }
      },
      "topology": {
        "orchestration_mode": "model_driven"
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "research_notes": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["research_notes"]
      }
    },
    {
      "agent_id": "writer",
      "role": "Professional Technical Writer",
      "prompt_template": {
        "template_id": "writer_v2",
        "template_string": "Draft a comprehensive report based on these research notes: {research_notes}",
        "input_variables": ["research_notes"]
      },
      "llm": {
        "provider": "openai",
        "model_name": "gpt-4o",
        "api_key_env_var": "OPENAI_API_KEY"
      },
      "consensus_config": {
        "enabled": true,
        "instances": 3,
        "threshold": 0.7
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "final_report": { "type": "string" },
          "word_count": { "type": "integer" }
        },
        "required": ["final_report"]
      },
      "topology": {
        "orchestration_mode": "agent_driven",
        "reasoning_steps": ["outline", "draft", "polish"]
      }
    }
  ],
  "edges": [
    {
      "source": "coordinator",
      "target": "__end__",
      "condition": {
        "field": "next_step",
        "operator": "==",
        "value": "finished"
      }
    }
  ],
  "hitl": {
    "interruption_points": ["coordinator"],
    "approval_timeout": 1800,
    "notification_channel": "slack"
  },
  "entry_point": "coordinator"
}
